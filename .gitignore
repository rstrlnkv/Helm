.DS_Store
.build/
build/
*.xcodeproj/xcuserdata/
DerivedData/

# The crew is local. Fourteen agent definitions and the plugin that installs
# them live on disk and are not part of the project's history: they are how one
# person drives this repository, not something it ships. `/plugin marketplace
# add ~/Projects/Claude/Helm` reads them from the working copy, so nothing about
# installing them needed git.
/.claude/agents/
/plugins/
/.claude-plugin/

# The reasoning stays private. ARCHITECTURE.md, CLAUDE.md and the docs/ tree of
# specs and plans are how this app is built rather than something it ships; they
# live on disk and in a private repository. The public tree carries the code,
# the changelog, the licence notice and how to build it.
/ARCHITECTURE.md
/CLAUDE.md
/docs/
