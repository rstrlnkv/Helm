    "helmShowsWhatItLeftBehind": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm zeigt die zurückgebliebenen Einstellungen, Caches und Support-Dateien, bereit zum Entfernen. Nur solange die App im Papierkorb liegt — ist er geleert, lässt sich nichts mehr zuordnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm shows the settings, caches and support files it left behind, ready to remove. Only while the app is still in the Trash — empty it first and there is nothing left to identify them by."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm muestra los ajustes, cachés y archivos de soporte que quedaron, listos para eliminar. Solo mientras la app está en la papelera: si la vacías, ya no hay forma de identificarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm montre les réglages, caches et fichiers de support laissés derrière, prêts à supprimer. Seulement tant que l’app est dans la corbeille\u00a0: une fois vidée, plus rien ne permet de les identifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残された設定・キャッシュ・サポートファイルを表示し、そのまま削除できます。App がゴミ箱にある間だけです。空にすると、どのファイルか見分けられなくなります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm mostra os ajustes, caches e arquivos de suporte que ficaram, prontos para remover. Só enquanto o app está no Lixo: depois de esvaziar, não há como identificá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm покажет оставшиеся настройки, кеши и служебные файлы — их можно сразу удалить. Только пока приложение в Корзине: если очистить ее, опознать файлы будет уже не по чему."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm 会列出它留下的设置、缓存和支持文件，可直接删除。仅在 App 还在废纸篓里时有效——清倒之后就无法辨认这些文件了。"
          }
        }
      }
    },
