    "withoutFullDiskAccess": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Festplattenvollzugriff bleiben die Container der App liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Full Disk Access an app’s containers stay behind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Acceso total al disco los contenedores de la app se quedarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans accès complet au disque, les conteneurs de l’app resteront."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスがないと、アプリのコンテナが残ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem Acesso Total ao Disco os contêineres do app permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без «Доступа к диску» контейнеры приложения останутся на диске."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有完全磁盘访问权限时，应用的容器会残留。"
          }
        }
      }
    },
    "withoutFullDiskAccessOrTheTrash": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Festplattenvollzugriff bleiben die Container einer App liegen, und Helm sieht den Papierkorb nicht, um nach Resten zu suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Full Disk Access an app’s containers stay behind, and Helm cannot see the Trash to look for leftovers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Acceso total al disco quedan los contenedores de la app y Helm no ve la papelera para buscar restos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans accès complet au disque, les conteneurs d’une app restent en place et Helm ne voit pas la corbeille pour y chercher des restes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスがないと App のコンテナが残り、Helm はゴミ箱を見て残存ファイルを探すこともできません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem Acesso Total ao Disco os contêineres do app ficam para trás e o Helm não vê o Lixo para procurar restos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без «Доступа к диску» контейнеры приложения останутся на диске, а Корзину Helm не увидит и остатки не найдет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有完全磁盘访问权限，App 的容器会残留，Helm 也看不到废纸篓、无法查找残留文件。"
          }
        }
      }
    }
  },
