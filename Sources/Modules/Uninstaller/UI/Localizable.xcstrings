    "filesLeftByAppsNoLongerHere": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die Apps in deiner Library hinterlassen haben, die du nicht mehr hast. Gelistet werden nur Dateien mit der Bundle-ID einer App — manche Reste fehlen daher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files left in your Library by apps you no longer have. Only files named after an app’s bundle id are listed, so some leftovers will not appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos que dejaron en tu Biblioteca apps que ya no tienes. Solo se listan los nombrados por el bundle id de una app, así que algunos restos no aparecerán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers laissés dans votre Bibliothèque par des apps que vous n’avez plus. Seuls ceux nommés d’après le bundle id d’une app sont listés, donc certains restes n’apparaîtront pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにないアプリがライブラリに残したファイル。アプリの bundle id を名前に持つファイルだけを表示するため、見つからない残存ファイルもあります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos deixados na sua Biblioteca por apps que você não tem mais. Só são listados os nomeados pelo bundle id de um app, então alguns restos não vão aparecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы, оставшиеся в Библиотеке от приложений, которых больше нет на этом Mac. В списке — только файлы, названные по bundle id приложения, поэтому часть остатков в него не попадет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已卸载应用留在资源库中的文件。仅列出以应用 bundle id 命名的文件，因此部分残留不会出现。"
          }
        }
      }
    },
