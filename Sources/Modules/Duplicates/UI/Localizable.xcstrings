    "helmWillReadThisFolder": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm liest, was in diesem Ordner ist, und vergleicht den Inhalt, nicht die Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm will read what is in this folder, comparing content rather than names."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm leerá lo que hay en esta carpeta, comparando el contenido y no los nombres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm lira ce que contient ce dossier, en comparant le contenu et non les noms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前ではなく中身を比較して、このフォルダの内容を調べます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm lerá o que há nesta pasta, comparando o conteúdo e não os nomes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm прочитает, что в этой папке, сравнивая содержимое, а не имена."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm 会读取此文件夹中的内容，并比较内容而非文件名。"
          }
        }
      }
    },
