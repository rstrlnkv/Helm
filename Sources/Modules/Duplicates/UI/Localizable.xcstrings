    "filesFromOneMB": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien ab 1 MB. Harte Links sind eine Datei und werden nie angeboten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files from 1 MB. Hard links are one file and are never offered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos desde 1 MB. Los enlaces duros son un solo archivo y nunca se ofrecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers à partir de 1 Mo. Les liens durs sont un seul fichier et ne sont jamais proposés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 MB 以上のファイルが対象。ハードリンクは同一ファイルなので提案されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos a partir de 1 MB. Links físicos são um só arquivo e nunca são oferecidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы от 1 МБ. Жесткие ссылки — это один файл, они не предлагаются."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "1 MB 以上的文件。硬链接是同一个文件，不会被列出。"
          }
        }
      }
    },
