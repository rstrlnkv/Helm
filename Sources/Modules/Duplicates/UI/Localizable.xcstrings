    "librariesNotOpened": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto- und Musikmediatheken wurden nicht geöffnet, ihr Inhalt wurde daher nicht verglichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo and music libraries were not opened, so what is inside them was not compared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fototecas y bibliotecas de música no se abrieron, así que su contenido no se comparó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photothèques et bibliothèques musicales n’ont pas été ouvertes, leur contenu n’a donc pas été comparé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真やミュージックのライブラリは開いていないため、その中身は比較されていません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As fototecas e bibliotecas de música não foram abertas, portanto o conteúdo delas não foi comparado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиатеки «Фото» и «Музыка» не открывались, поэтому их содержимое не сравнивалось."
          }
