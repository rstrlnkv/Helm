    "withoutFullDiskAccess": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Festplattenvollzugriff kann Helm nicht jeden Ordner lesen — und eine kurze Liste sieht genauso aus wie ein Ordner ohne Duplikate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Full Disk Access Helm cannot read every folder, and a short list of duplicates looks exactly like a folder that has none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Acceso total al disco Helm no puede leer todas las carpetas, y una lista corta se ve igual que una carpeta sin duplicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans accès complet au disque, Helm ne peut pas lire tous les dossiers, et une courte liste ressemble exactement à un dossier sans doublons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスがないとすべてのフォルダを読めず、結果が少ないのか重複がないのか区別できません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem Acesso Total ao Disco o Helm não consegue ler todas as pastas, e uma lista curta parece exatamente uma pasta sem duplicatas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без «Доступа к диску» Helm прочитает не все папки: часть дубликатов не найдется, а результат будет выглядеть так же, как чистая папка."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有完全磁盘访问权限时，Helm 无法读取全部文件夹；结果少和没有重复看起来一模一样。"
          }
        }
      }
    },
