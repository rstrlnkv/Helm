    "couldNotRead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm konnte %@ nicht lesen, die Antwort ist daher unvollständig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm could not read %@, so the answer is incomplete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm no pudo leer %@, por lo que la respuesta está incompleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm n’a pas pu lire %@, la réponse est donc incomplète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm は%@を読み取れなかったため、この結果は完全ではありません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm não conseguiu ler %@, portanto a resposta está incompleta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm не смог прочитать %@, поэтому ответ неполный."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm 无法读取%@，因此这不是完整的结果。"
          }
        }
      }
    },
