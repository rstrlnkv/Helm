    "lidGrantExplained": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt nach einem Adminpasswort und behält eine Regel in /etc/sudoers.d. Wird dies ausgeschaltet, verschwindet die Regel ohne zweites Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for an administrator password and keeps a rule in /etc/sudoers.d. Switching this off removes the rule without a second password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide una contraseña de administración y deja una regla en /etc/sudoers.d. Al desactivar esto, la regla se elimina sin una segunda contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande un mot de passe administrateur et conserve une règle dans /etc/sudoers.d. Désactiver ceci retire la règle sans second mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が管理者パスワードを求め、/etc/sudoers.d にルールを残します。この設定をオフにすると、二度目のパスワードなしでルールは削除されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pede uma senha de administrador e mantém uma regra em /etc/sudoers.d. Desativar isto remove a regra sem uma segunda senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запросит пароль администратора и оставит правило в /etc/sudoers.d. Выключение этой настройки убирает правило без второго пароля."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会要求输入管理员密码，并在 /etc/sudoers.d 保留一条规则。关闭此设置会移除该规则，无需再次输入密码。"
          }
        }
      }
    },
    "lidGrantRefused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat es abgelehnt, den Ruhezustand auszuschalten, daher geht der Mac bei geschlossenem Deckel wie gewohnt in den Ruhezustand. Die Regel in /etc/sudoers.d wurde möglicherweise geändert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS refused to turn sleep off, so closing the lid will let the Mac sleep. The rule in /etc/sudoers.d may have been changed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS se negó a desactivar el reposo, así que el Mac entrará en reposo al cerrar la tapa. Puede que la regla en /etc/sudoers.d haya cambiado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a refusé de désactiver la veille, donc le Mac se met en veille quand vous fermez le couvercle. La règle dans /etc/sudoers.d a peut-être été modifiée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がスリープをオフにするのを拒否したため、ふたを閉じると Mac はスリープ状態になります。/etc/sudoers.d のルールが変更されている可能性があります"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS recusou-se a desligar o repouso, então o Mac entra em repouso ao fechar a tampa. A regra em /etc/sudoers.d pode ter sido alterada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS отказалась выключить режим сна, поэтому с закрытой крышкой Mac все равно заснет. Возможно, правило в /etc/sudoers.d изменили"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 拒绝关闭睡眠，因此合盖后 Mac 仍会进入睡眠。/etc/sudoers.d 中的规则可能已被更改"
          }
        }
      }
    },
    "lidRuleStillThere": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regel in /etc/sudoers.d ist noch da. Schalte diese Einstellung ein und wieder aus, um sie zu entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule in /etc/sudoers.d is still there. Switch this on and off again to remove it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La regla en /etc/sudoers.d sigue ahí. Activa y desactiva este ajuste de nuevo para eliminarla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La règle dans /etc/sudoers.d est toujours là. Activez puis désactivez ce réglage pour la supprimer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/etc/sudoers.d のルールがまだ残っています。この設定をオンにして再度オフにすると削除できます"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A regra em /etc/sudoers.d ainda está lá. Ative e desative este ajuste de novo para removê-la"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило в /etc/sudoers.d осталось. Чтобы его убрать, эту настройку нужно включить и снова выключить"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "/etc/sudoers.d 中的规则仍然存在。将此设置开启后再关闭即可移除"
          }
        }
      }
    },
