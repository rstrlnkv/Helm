          }
        }
      }
    },
    "deleteHelmLeavesRule": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird Helm gelöscht, während es noch läuft, bleibt die Regel zurück. So lässt sie sich von Hand entfernen:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Helm while it is still running and the rule stays behind. To remove it by hand:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se elimina Helm mientras sigue abierto, la regla se queda. Para quitarla a mano:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Helm est supprimé alors qu’il tourne encore, la règle reste. Pour la retirer à la main :"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm が動いたまま削除された場合、ルールは残ります。手動で削除するコマンド："
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Helm for apagado enquanto ainda está aberto, a regra fica. Para removê-la à mão:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если удалить Helm, пока он еще работает, правило останется. Чтобы убрать его вручную:"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "若 Helm 仍在运行时被删除，规则会留下。手动移除的命令："
          }
        }
      }
    },
