    "stopPausesRule": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Stopp“ pausiert die Regel, bis sie wieder zutrifft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop pauses the rule until it applies again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Detener” pone la regla en pausa hasta que vuelva a cumplirse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Stop » met la règle en pause jusqu’à ce qu’elle s’applique de nouveau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“停止”は、次に条件を満たすまでルールを一時停止します"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Parar” pausa a regra até ela se aplicar de novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Стоп» поставит правило на паузу до следующего срабатывания"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "“停止”会暂停该规则，直到它再次满足"
          }
        }
      }
    },
