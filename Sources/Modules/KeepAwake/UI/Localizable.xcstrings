    "defaultDurationHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So lange halten der Schalter im Panel und der Tastaturkurzbefehl den Mac wach"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the panel's switch and the keyboard shortcut keep the Mac awake"
          }
        },
        "es": {
