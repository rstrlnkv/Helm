    "activeIconColourHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur solange der Mac wach gehalten wird. Sonst zeigt Helm sein gemeinsames Symbol"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while the Mac is kept awake. At other times Helm shows its shared icon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mientras el Mac se mantiene despierto. El resto del tiempo Helm muestra su icono común"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement tant que le Mac est maintenu éveillé. Sinon, Helm affiche son icône commune"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac を起こしている間だけ。ほかのときは Helm の共通アイコンです"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só enquanto o Mac é mantido acordado. Nas outras horas o Helm mostra seu ícone comum"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только пока Helm держит Mac. В остальное время — общий значок"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 Mac 保持唤醒时。其余时间显示 Helm 的通用图标"
          }
        }
      }
    },
