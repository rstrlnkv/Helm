    "countdownRingHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während ein Timer läuft, leert sich der Ring im Uhrzeigersinn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While a timer runs, the ring empties clockwise"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras corre el temporizador, el anillo se vacía en sentido horario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le minuteur, l’anneau se vide dans le sens horaire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマー中はリングが時計回りに減ります"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o timer está ativo, o anel se esvazia no sentido horário"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока идет таймер, кольцо убывает по часовой стрелке"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "计时期间圆环会顺时针减少"
