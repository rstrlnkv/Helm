    "sleepOffNowSwitchingBack": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ruhezustand ist gerade für den ganzen Mac aus. Schalte diese Einstellung aus, um den Ruhezustand wieder zu aktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep is off for the whole Mac right now. Switching this off turns sleep back on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reposo está desactivado ahora mismo en todo el Mac. Desactiva este ajuste para volver a activar el reposo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La veille est actuellement désactivée pour tout le Mac. Désactivez ce réglage pour réactiver la veille"
          }
        },
        "ja": {
