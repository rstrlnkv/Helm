    "appRulesEmptyHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie eine App hinzu, und der Mac bleibt wach, solange sie läuft. Eine Regel lässt sich auf Netzstrom, auf einen externen Bildschirm oder auf beides begrenzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an app and the Mac stays awake while it is running. You can limit a rule to power, to an external display, or to both."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una app y el Mac seguirá despierto mientras se ejecute. Puedes limitar la regla a la corriente, a una pantalla externa o a ambas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une app et le Mac reste éveillé tant qu’elle tourne. Vous pouvez limiter la règle au secteur, à un écran externe, ou aux deux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを追加すると、そのアプリが動いている間 Mac はスリープしません。ルールは電源接続時のみ、外部ディスプレイ接続時のみ、またはその両方に絞れます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um app e o Mac fica acordado enquanto ele estiver em execução. Você pode limitar a regra à tomada, a um monitor externo ou a ambos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не будет засыпать, пока запущено добавленное приложение. Правило можно ограничить: только при питании, только с внешним дисплеем или и тем и другим."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个 App，它运行时 Mac 就不会睡眠。你可以把规则限定为接电源时、接外接显示器时，或两者兼有。"
          }
        }
      }
    },
    "appRulesUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm kann die gespeicherten App-Regeln nicht lesen, daher hält keine App den Mac wach. Füge die Apps erneut hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm cannot read the saved app rules, so no app is keeping the Mac awake. Add the apps again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm no puede leer las reglas de apps guardadas, así que ninguna app mantiene el Mac despierto. Añade las apps de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm ne peut pas lire les règles d’apps enregistrées, donc aucune app ne maintient le Mac éveillé. Ajoutez à nouveau les apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm が保存されたアプリのルールを読み取れないため、どのアプリも Mac を起きたままにしていません。アプリをもう一度追加してください"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm não consegue ler as regras de apps salvas, então nenhum app mantém o Mac acordado. Adicione os apps de novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm не может прочитать сохраненные правила приложений, поэтому ни одно приложение не мешает Mac заснуть. Приложения нужно добавить заново"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm 无法读取已保存的 App 规则，因此没有 App 让 Mac 保持唤醒。请重新添加这些 App"
          }
        }
      }
    },
