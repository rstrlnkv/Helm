    "brewGone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ist nicht mehr installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew is no longer installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ya no está instalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew n’est plus installé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew はアンインストールされています。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew não está mais instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew больше не установлен."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 已被卸载。"
          }
        }
      }
    },
    "brewNamedNoCommand": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew hat hier keinen Befehl genannt — es hat gesagt, was nicht stimmt, und es dabei belassen. Die Zeile darüber ist Helms eigene Lesart davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew named no command here — it said what is wrong and left it at that. The line above is Helm’s own reading of that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew no indicó aquí ningún comando: dijo qué va mal y se quedó ahí. La línea de arriba es la lectura que Helm hace de eso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew n’a nommé aucune commande ici : il a dit ce qui n’allait pas et s’en est tenu là. La ligne ci-dessus est la lecture qu’en fait Helm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew はここでコマンドを示していません。何が問題かを述べただけです。上の行は、それを Helm が読み取った結果です。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew não indicou aqui nenhum comando: disse o que está errado e ficou por aí. A linha acima é a leitura que o Helm faz disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew не назвал здесь никакой команды — он сказал, что не так, и на этом остановился. Строка выше — это то, как ее прочитал сам Helm."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 在这里没有给出任何命令，它只说明了问题所在。上面那行是 Helm 自己的解读。"
          }
        }
      }
    },
    "brewsOwnReason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der von Homebrew genannte Grund: %@"
          }
        },
        "en": {
