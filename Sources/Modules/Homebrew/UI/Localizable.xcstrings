          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O motivo indicado pelo Homebrew: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Причина, которую называет Homebrew: %@"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 给出的理由：%@"
          }
        }
      }
    },
    "cameAsDependency": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kam als Abhängigkeit — Sie haben es nicht angefordert. Es sollte zusammen mit dem entfernt werden, was es mitgebracht hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It came in as a dependency — you did not ask for it. It is worth removing together with whatever brought it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegó como dependencia: no lo pediste. Conviene eliminarlo junto con lo que lo trajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est arrivé comme dépendance — vous ne l’avez pas demandé. Mieux vaut le supprimer avec ce qui l’a amené."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依存関係として入ってきたもので、あなたが指定したものではありません。連れてきたパッケージと一緒に削除するのがよいでしょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele chegou como dependência: você não o pediu. Convém removê-lo junto com o que o trouxe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пришел как зависимость — не по запросу. Удалять его стоит вместе с тем, кто его привел."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "它是作为依赖装上的，不是你要求的。删除时最好连带引入它的那个包一起删。"
          }
        }
      }
    },
