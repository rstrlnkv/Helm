    "uninstallIsPermanent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew entfernt es sofort. Es landet nicht im Papierkorb und lässt sich nicht zurückholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew removes it right away. It does not go to the Trash, and this cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew lo elimina de inmediato. No va a la papelera y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew le supprime immédiatement. Il ne va pas dans la corbeille et c’est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew はすぐに削除します。ゴミ箱には入らず、取り消せません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew remove na hora. Não vai para o Lixo e não dá para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew удалит его сразу. В Корзину он не попадет, и отменить это будет нельзя."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 会立即删除。它不会进入废纸篓，也无法撤销。"
