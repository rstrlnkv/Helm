          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "outils de développement de ligne de commande"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドラインデベロッパツール"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ferramentas de linha de comando para desenvolvedores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "инструменты командной строки для разработчиков"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "命令行开发者工具"
          }
        }
      }
    },
    "authorizationDeclined": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Administratorautorisierung wurde abgebrochen, daher wurde Homebrew nicht installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator authorization was cancelled, so Homebrew was not installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló la autorización de administrador, así que Homebrew no se instaló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation de l’administrateur a été annulée, donc Homebrew n’a pas été installé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者の認証がキャンセルされたため、Homebrew はインストールされませんでした。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A autorização de administrador foi cancelada, então o Homebrew não foi instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авторизация администратора отменена, поэтому Homebrew не установлен."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消管理员授权，因此未安装 Homebrew。"
          }
        }
      }
    },
