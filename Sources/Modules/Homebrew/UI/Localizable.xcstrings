    "couldNotCheckForUpdates": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew hat nicht geantwortet, daher ist über Updates derzeit nichts bekannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew did not answer, so nothing is known about updates right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew no respondió, así que ahora mismo no se sabe nada sobre las actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew n’a pas répondu, donc rien n’est connu des mises à jour pour l’instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew が応答しなかったため、更新は今のところ分かりません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew não respondeu, por isso nada se sabe sobre as atualizações neste momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew не ответил, поэтому об обновлениях сейчас ничего не известно."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 没有回应，因此目前无法得知有哪些更新。"
          }
        }
      }
    },
