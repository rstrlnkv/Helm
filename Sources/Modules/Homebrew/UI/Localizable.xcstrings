    "notInstalledBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm lädt Homebrews eigenes Installationsprogramm und führt es aus. Sind die %@ noch nicht installiert, installiert macOS sie zuerst in einem eigenen Fenster, und Helm macht weiter, sobald sie bereit sind. Zum Anlegen von /opt/homebrew fragt macOS nach einem Adminpasswort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm downloads Homebrew’s own installer and runs it. If the %@ are not installed yet, macOS installs them first, in a window of its own, and Helm carries on when they are ready. macOS asks for an administrator password to create /opt/homebrew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm descarga el instalador oficial de Homebrew y lo ejecuta. Si las %@ aún no están instaladas, macOS las instala primero en su propia ventana y Helm continúa cuando están listas. macOS solicita una contraseña de administración para crear /⁠opt/⁠homebrew."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm télécharge le programme d’installation officiel de Homebrew et l’exécute. Si les %@ ne sont pas encore installés, macOS les installe d’abord dans sa propre fenêtre, puis Helm continue dès qu’ils sont prêts. macOS demande un mot de passe d’administrateur pour créer /opt/homebrew."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm が Homebrew 公式のインストーラをダウンロードして実行します。%@がまだインストールされていない場合は、まず macOS が専用のウインドウでインストールし、準備ができたら Helm が続行します。/opt/homebrew を作るため、macOS が管理者パスワードを求めます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm baixa o instalador oficial do Homebrew e o executa. Se as %@ ainda não estiverem instaladas, o macOS as instala primeiro em uma janela própria, e o Helm continua quando estiverem prontas. O macOS pede uma senha de administrador para criar /opt/homebrew."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm скачает официальный установщик Homebrew и запустит его. Если %@ еще не установлены, macOS сначала установит их в своем окне, а Helm продолжит, когда они будут готовы. Чтобы создать /opt/homebrew, macOS запросит пароль администратора."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm 会下载 Homebrew 官方安装脚本并运行。若尚未安装%@，macOS 会先在自己的窗口中安装，完成后 Helm 会自动继续。为创建 /opt/homebrew，macOS 会要求输入管理员密码。"
          }
        }
      }
    },
