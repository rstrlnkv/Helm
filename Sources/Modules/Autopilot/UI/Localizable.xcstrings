    "pointHelmAtAFolderAnd": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner und gib ihm Regeln. Eine ankommende Datei wird der Reihe nach geprüft, die erste passende gewinnt — und jeder Ordner wird stündlich erneut durchgesehen, damit auch Altersregeln greifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point Helm at a folder and give it rules. A file that arrives is checked against them in order and the first match wins — and every watched folder is checked again once an hour, so age rules come round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica una carpeta y dale reglas. Un archivo que llega se comprueba en orden y gana la primera coincidencia; además, cada carpeta se repasa una vez por hora, para que las reglas de antigüedad también lleguen a actuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désignez un dossier et donnez-lui des règles. Un fichier qui arrive est vérifié dans l’ordre et la première correspondance l’emporte — et chaque dossier est repassé une fois par heure, pour que les règles d’ancienneté s’appliquent aussi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを指定してルールを与えます。届いたファイルは上から順に照合され、最初に一致したルールが実行されます。さらに 1 時間ごとに全体を見直すので、“〜より古い”のルールも働きます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte o Helm para uma pasta e dê regras a ela. Um arquivo que chega é verificado na ordem e a primeira que casa vence — e cada pasta é revista uma vez por hora, para que as regras de idade também rodem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для папки задаются правила. Появившийся файл сверяется с ними по порядку, срабатывает первое подошедшее — и раз в час Helm обходит папку заново, чтобы правила про возраст тоже доходили до дела."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "指定一个文件夹并为它设定规则。新到的文件按顺序检查，第一条匹配的生效；每小时还会把文件夹重新过一遍，所以“早于”这类规则也会轮到。"
          }
        }
      }
    },
