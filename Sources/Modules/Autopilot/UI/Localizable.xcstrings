        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Acceso total al disco una carpeta protegida se lee vacía: ninguna regla coincide, y eso se ve igual que una carpeta sin nada que hacer."
          }
        },
        "fr": {
          "stringUnit": {
