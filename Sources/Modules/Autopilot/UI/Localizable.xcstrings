    "helmCannotReadTheKeyIts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm kann den Schlüssel, mit dem die Regeln versiegelt sind, nicht lesen, daher wird keine davon ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm cannot read the key its rules are sealed with, so none of them are running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm no puede leer la clave con la que están selladas las reglas, así que ninguna se está ejecutando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm ne peut pas lire la clé qui scelle ses règles\u00a0: aucune ne s’exécute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールの署名に使う鍵を読み取れません。どのルールも実行されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm não consegue ler a chave que sela as suas regras, por isso nenhuma está a ser executada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm не может прочитать ключ, которым подписаны правила, — ни одно из них не выполняется."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm 无法读取用于签名规则的密钥，因此没有任何规则在运行。"
          }
        }
      }
    },
