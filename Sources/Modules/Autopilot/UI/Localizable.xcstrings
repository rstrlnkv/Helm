{
  "sourceLanguage": "en",
  "strings": {
    "aRuleCanWatchFoldersInside": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel kann Ordner im Benutzerordner beobachten, aber weder die Library noch ein ganzes Volume."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rule can watch folders inside your home folder, but not the Library and not a whole volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla puede vigilar carpetas dentro de la carpeta personal, pero no la Biblioteca ni un volumen entero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle peut surveiller des dossiers dans votre dossier personnel, mais pas la Bibliothèque ni un volume entier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールはホームフォルダ内のフォルダを監視できますが、ライブラリやボリューム全体は監視できません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra pode vigiar pastas dentro da pasta pessoal, mas não a Biblioteca nem um volume inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило может наблюдать за папками внутри домашней папки, но не за Библиотекой и не за целым томом."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "规则可以监视个人文件夹内的文件夹，但不能监视资源库或整个宗卷。"
          }
        }
      }
    },
    "aRuleIsADecisionMade": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel ist eine einmal getroffene und danach immer ausgeführte Entscheidung — deshalb wird sie vor dem Einschalten gezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rule is a decision made once and carried out from then on, so it is shown before it is switched on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla es una decisión tomada una vez y ejecutada desde entonces, por eso se muestra antes de activarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle est une décision prise une fois et appliquée ensuite toujours\u00a0: elle est donc montrée avant d’être activée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールは一度決めたらその後ずっと実行される判断なので、有効にする前に内容を示します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra é uma decisão tomada uma vez e executada dali em diante, por isso ela é mostrada antes de ser ligada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило — это решение, принятое один раз и исполняемое дальше всегда, поэтому его показывают до включения."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "规则是一次做出、此后一直执行的决定，所以在开启之前先展示它。"
          }
        }
      }
    },
