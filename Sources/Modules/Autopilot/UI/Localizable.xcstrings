        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mark that stops a rule acting twice could not be written, so the rule may take this file again within the hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo escribir la marca que impide que una regla actúe dos veces, así que la regla puede llevarse este archivo otra vez dentro de una hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La marque qui empêche une règle d’agir deux fois n’a pas pu être écrite\u00a0: la règle peut reprendre ce fichier dans l’heure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールが二度目に働くのを止める印を書き込めませんでした。1 時間以内にルールがこのファイルをまた動かす可能性があります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gravar a marca que impede uma regra de agir duas vezes, então a regra pode levar este arquivo de novo dentro de uma hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метку, которая не дает правилу сработать дважды, записать не удалось — в течение часа правило может забрать этот файл снова."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入阻止规则重复执行的标记，规则可能在一小时内再次处理这个文件。"
          }
        }
      }
    },
