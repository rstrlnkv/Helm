    "nothingYetAFileThatArrives": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts. Eine ankommende Datei wird sofort geprüft, und jeder beobachtete Ordner wird einmal pro Stunde durchgegangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. A file that arrives is checked as it lands, and every watched folder is swept once an hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada por ahora. Un archivo que llega se comprueba al momento, y cada carpeta vigilada se repasa una vez por hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l’instant. Un fichier qui arrive est examiné aussitôt, et chaque dossier surveillé est parcouru une fois par heure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もありません。届いたファイルはその場で確認され、監視中のフォルダは1時間に1度点検されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada ainda. Um arquivo que chega é verificado na hora, e cada pasta observada é percorrida uma vez por hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего. Новый файл проверяется сразу, а все отслеживаемые папки — раз в час."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时还没有。文件一到就会检查，每个受监视的文件夹每小时清理一次。"
          }
        }
      }
    },
