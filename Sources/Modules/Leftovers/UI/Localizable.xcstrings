            "value": "Escanea para ver qué dejaron las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez pour voir ce que les apps ont laissé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンして、アプリが残したものを確認。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie para ver o que os apps deixaram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
