    "confirmDeleteInUse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in den Papierkorb legen? Es ist gerade geladen, und die App, die es installiert hat, kann es neu anlegen. %@ stoppt es jetzt; die Datei zu verschieben nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move %@ to the Trash? It is loaded now, and the app that installed it may put it back. %@ stops it now; moving the file does not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Trasladar %@ a la papelera? Está cargado ahora y la app que lo instaló podría volver a crearlo. %@ lo detiene ahora; mover el archivo no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer %@ dans la corbeille ? Il est chargé, et l’app qui l’a installé peut le recréer. %@ l’arrête maintenant ; déplacer le fichier, non."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をゴミ箱に入れますか？現在読み込まれており、インストールしたアプリが再作成する場合があります。今すぐ止めるには %@ を押してください。ファイルを移動しても止まりません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover %@ para o Lixo? Está carregado agora, e o app que o instalou pode recriá-lo. %@ o interrompe agora; mover o arquivo não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить %@ в Корзину? Этот файл сейчас загружен, и приложение, которое его установило, может создать его заново. %@ остановит его сейчас, а перемещение файла — нет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 移到废纸篓？它当前已加载，安装它的应用可能会重新创建。%@ 会立即停止它；移动文件不会。"
          }
        }
      }
    },
    "confirmDeleteUnchecked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in den Papierkorb legen? Helm konnte nicht prüfen, ob es noch verwendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move %@ to the Trash? Helm could not check whether anything still uses it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Trasladar %@ a la papelera? Helm no pudo comprobar si algo lo sigue usando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer %@ dans la corbeille ? Helm n’a pas pu vérifier si quelque chose l’utilise encore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をゴミ箱に入れますか？何かがまだ使用しているか、Helm は確認できませんでした。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover %@ para o Lixo? O Helm não conseguiu verificar se algo ainda o usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить %@ в Корзину? Helm не смог проверить, использует ли его что-нибудь."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 移到废纸篓？Helm 无法确认是否还有程序在使用它。"
          }
        }
      }
    },
    "confirmDeleteUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in den Papierkorb legen? Helm konnte diese Datei nicht lesen und weiß daher nicht, was sie installiert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move %@ to the Trash? Helm could not read this file, so it cannot tell what installed it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Trasladar %@ a la papelera? Helm no pudo leer este archivo, así que no sabe qué lo instaló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer %@ dans la corbeille ? Helm n’a pas pu lire ce fichier et ne sait donc pas ce qui l’a installé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をゴミ箱に入れますか？Helm はこのファイルを読み取れず、何がインストールしたか判断できません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover %@ para o Lixo? O Helm não conseguiu ler este arquivo, portanto não sabe o que o instalou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить %@ в Корзину? Helm не смог прочитать этот файл и не знает, что его установило."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 移到废纸篓？Helm 无法读取此文件，因此无法判断是什么安装了它。"
          }
        }
      }
    },
