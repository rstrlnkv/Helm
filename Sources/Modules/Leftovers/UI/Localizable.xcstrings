      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startagenten, Einstellungsdateien, Plug-ins und Systemerweiterungen. Nur Reste können in den Papierkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch agents, settings files, plug-ins and system extensions. Only leftovers can go to the Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes de inicio, archivos de ajustes, módulos y extensiones del sistema. Solo los restos pueden ir a la papelera."
