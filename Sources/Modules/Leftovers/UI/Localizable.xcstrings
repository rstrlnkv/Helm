    "nothingIsSelectedForYou": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ist vorausgewählt: macOS lädt jedes Objekt in dieser Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is selected for you: macOS loads every item in this list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada viene seleccionado: macOS carga cada ítem de esta lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est sélectionné : macOS charge chaque élément de cette liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定では何も選択されていません。このリストの項目はすべて macOS が読み込みます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada vem selecionado: o macOS carrega cada item desta lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не отмечено заранее: macOS загружает каждый объект из этого списка."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "默认不选择任何项目：这个列表里的每一项都由 macOS 加载。"
          }
        }
      }
    },
