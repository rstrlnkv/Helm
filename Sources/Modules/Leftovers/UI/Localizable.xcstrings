    "scanNeedsFullDiskAccess": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Festplattenvollzugriff kann Helm nicht jedes Objekt prüfen — und eine kurze Liste von Resten sieht genauso aus wie ein Mac ganz ohne Reste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Full Disk Access Helm cannot check every item, and a short list of leftovers looks exactly like a Mac with none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Acceso total al disco Helm no puede comprobar todos los elementos, y una lista corta de restos se ve igual que un Mac sin ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans accès complet au disque, Helm ne peut pas vérifier tous les éléments, et une courte liste de restes ressemble exactement à un Mac qui n’en a aucun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスがないとすべての項目を確認できず、残存物が少ないのか無いのか区別できません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem Acesso Total ao Disco o Helm não consegue verificar todos os itens, e uma lista curta de restos parece exatamente um Mac sem nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без «Доступа к диску» Helm проверит не все объекты: часть остатков не найдется, а список будет выглядеть так же, как на чистом Mac."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有完全磁盘访问权限时，Helm 无法检查全部项目；残留项少和没有残留看起来一模一样。"
          }
        }
      }
    },
