    "neverInAPasswordFieldAnd": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie in einem Passwortfeld und nie in den Terminals und Passwortmanagern, die Helm kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never in a password field, and never in the terminals and password managers Helm knows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca en un campo de contraseña, ni en los terminales y gestores de contraseñas que Helm conoce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais dans un champ de mot de passe, ni dans les terminaux et gestionnaires de mots de passe que Helm connaît."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード欄では決して動きません。Helm が知っているターミナルとパスワード管理アプリでも動きません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca num campo de senha, nem nos terminais e gerenciadores de senha que o Helm conhece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В поле пароля — никогда. И не в тех терминалах и менеджерах паролей, которые Helm знает."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在密码框中从不介入，Helm 已知的终端和密码管理器也不介入。"
          }
        }
      }
    },
