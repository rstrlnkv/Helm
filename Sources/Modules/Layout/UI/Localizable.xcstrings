    "onlyWhenWhatYouTypedIs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn das Getippte kein Wort ist und in der anderen Belegung eines wird. Was schon ein Wort ist, bleibt unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when what you typed is not a word and becomes one in the other layout. Anything that is already a word is left alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuando lo escrito no es una palabra y sí lo es en la otra distribución. Lo que ya es una palabra no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement si ce que vous avez tapé n’est pas un mot et en devient un dans l’autre disposition. Ce qui est déjà un mot reste intact."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力どおりでは単語でなく、別の配列にすると単語になる場合だけです。すでに単語であるものには触れません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quando o que você digitou não é palavra e passa a ser no outro layout. O que já é palavra fica intacto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только если набранное — не слово, а в другой раскладке становится словом. Все, что и так слово, остается нетронутым."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当按原样不是单词、换到另一个布局才是单词时才会改。已经是单词的一律不动。"
          }
        }
      }
    },
