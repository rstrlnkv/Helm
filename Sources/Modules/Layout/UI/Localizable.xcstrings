          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の言語インジケータはこの許可がなくても動きます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O indicador de idioma abaixo funciona sem esta permissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индикатор языка ниже работает и без этого разрешения."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "下方的语言指示器无需此权限也能使用。"
          }
        }
      }
    },
    "theseAreLeftExactlyAsYou": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese bleiben genau so, wie Sie sie getippt haben — ganz gleich, was das Wörterbuch meint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are left exactly as you typed them, whatever the dictionary thinks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas se dejan exactamente como las escribiste, piense lo que piense el diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces mots restent exactement tels que vous les avez tapés, quoi qu’en pense le dictionnaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに入れた語は、辞書が何と言おうと入力したままにします。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas ficam exatamente como você as digitou, pense o dicionário o que pensar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти слова остаются ровно такими, как набраны, что бы ни думал словарь."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这些词无论词典怎么判断，都会保持你输入时的样子。"
          }
        }
      }
    },
    "thisIsAKeyYouType": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine Taste, mit der du schreibst. Gehalten oder kombiniert funktioniert sie normal, aber ein versehentlicher einzelner Tipp korrigiert das letzte Wort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a key you type with. It still works normally when held or combined, but a stray tap on its own will fix the last word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una tecla que usas al escribir. Mantenida o combinada sigue funcionando igual, pero una pulsación suelta por descuido corregirá la última palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une touche dont vous vous servez en tapant. Maintenue ou combinée elle fonctionne normalement, mais une pression isolée par mégarde corrigera le dernier mot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは入力に使うキーです。押しっぱなしや同時押しでは通常どおりですが、単独でうっかり叩くと直前の単語が修正されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma tecla que você usa para digitar. Segurada ou combinada funciona normalmente, mas um toque solto por acidente vai corrigir a última palavra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой клавишей печатают. Зажатая или в сочетании она работает как обычно, но случайное одиночное нажатие исправит последнее слово."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你打字时会用到的键。按住或组合使用时一切照常，但不小心单独敲一下就会修正上一个词。"
          }
        }
      }
    },
