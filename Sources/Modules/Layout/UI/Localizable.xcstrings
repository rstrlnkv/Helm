    "tapAgainToPutTheChange": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch einmal antippen, um die Änderung zurückzunehmen, oder den Text erneut auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap again to put the change back, or select the text again to change it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Púlsala otra vez para deshacer el cambio, o vuelve a seleccionar el texto para revertirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez de nouveau pour annuler le changement, ou resélectionnez le texte pour le rétablir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度押すと変更を元に戻せます。選択し直しても戻せます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque de novo para desfazer a alteração, ou selecione o texto outra vez para revertê-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторное нажатие отменяет замену, а выделенный текст возвращается, если выделить его снова."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次即可撤销更改，或重新选中文字以还原。"
          }
        }
      }
    },
    "tapItOnItsOwnIt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allein antippen: korrigiert die Auswahl oder das letzte Wort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap it on its own: it fixes the selection, or the last word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Púlsala sola: corrige la selección o la última palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez dessus seule\u00a0: elle corrige la sélection ou le dernier mot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単独で押すと、選択した文字か直前の語を修正します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nela sozinha: corrige a seleção ou a última palavra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одиночное нажатие, без других клавиш, исправляет выделенное или последнее слово."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "单独按一下：修正选中的文字，或最后一个词。"
          }
        }
      }
    },
    "tappingControlOnItsOwnAlso": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelnes Tippen auf die Control-Taste pausiert auch die VoiceOver-Sprachausgabe. Wer VoiceOver nutzt, wählt besser eine andere Taste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping Control on its own also pauses VoiceOver speech. If you use VoiceOver, pick another key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsar Control a solas también pausa la voz de VoiceOver. Si usas VoiceOver, elige otra tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyer sur Contrôle seule met aussi en pause la voix de VoiceOver. Si vous utilisez VoiceOver, choisissez une autre touche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Control キーを単独で押すと VoiceOver の読み上げも一時停止します。VoiceOver をお使いなら別のキーを選んでください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar em Controle sozinha também pausa a fala do VoiceOver. Se você usa o VoiceOver, escolha outra tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одиночное нажатие Control также приостанавливает речь VoiceOver. С VoiceOver лучше выбрать другую клавишу."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "单独按下 Control 也会暂停 VoiceOver 的朗读。如果你使用 VoiceOver，请选择其他按键。"
          }
        }
      }
    },
    "terminalsAndPasswordManagersStartSwitched": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Terminals und Passwortmanagern ist das Korrigieren zunächst aus: dort ist ein Wort, das falsch aussieht, oft genau das richtige."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminals and password managers start switched off: there a word that looks wrong is often exactly right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los terminales y gestores de contraseñas la corrección empieza desactivada: allí una palabra que parece mal escrita suele ser exactamente la correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les terminaux et gestionnaires de mots de passe, la correction est désactivée au départ\u00a0: là, un mot qui semble faux est souvent exactement le bon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルとパスワード管理アプリでは最初はオフです。そこでは間違って見える語こそ正しいことが多いからです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em terminais e gerenciadores de senhas a correção começa desligada: ali, uma palavra que parece errada costuma ser exatamente a certa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В терминалах и менеджерах паролей исправление по умолчанию выключено: там слово, похожее на ошибку, чаще всего именно то, что нужно."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "终端和密码管理器默认关闭：在那里，看起来写错的词往往正是对的。"
          }
        }
      }
    },
    "theLanguageIndicatorBelowWorksWithout": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprachanzeige unten funktioniert auch ohne diese Berechtigung."
