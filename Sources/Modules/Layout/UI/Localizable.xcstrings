    "helmNeverReadsAPasswordA": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm liest niemals ein Passwort: ein vom System als sicher markiertes Feld wird ganz übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm never reads a password: a field the system marks as secure is skipped whole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm nunca lee contraseñas: omite por completo un campo que el sistema marca como seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm ne lit jamais un mot de passe\u00a0: un champ marqué comme sécurisé par le système est ignoré en entier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm はパスワードを読みません。システムが保護対象と示した入力欄は丸ごと飛ばします。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm nunca lê senhas: um campo que o sistema marca como seguro é ignorado por inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm не читает пароли: поле, которое система пометила как защищенное, он не трогает вовсе."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm 从不读取密码：系统标记为安全的输入框会被整体跳过。"
          }
        }
      }
    },
