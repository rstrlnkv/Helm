          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если набрать ghbdtn, забыв переключить раскладку, Helm заменит это на «привет» и сам переключит раскладку."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用错布局输入 ghbdtn，它会变成 привет，输入法也随之切换。"
          }
