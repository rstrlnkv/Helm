    "typeGhbdtnInTheWrongLayout": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ghbdtn in der falschen Belegung, und daraus wird привет — die Eingabequelle wechselt mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type ghbdtn in the wrong layout and it becomes привет, with the input source switching to match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe ghbdtn en la distribución equivocada y se convierte en привет; la fuente de entrada cambia con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez ghbdtn dans la mauvaise disposition\u00a0: le mot devient привет, et la source de saisie suit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配列を切り替え忘れて ghbdtn と入力すると、привет に直り、入力ソースも切り替わります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
