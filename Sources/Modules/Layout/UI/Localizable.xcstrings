{
  "sourceLanguage": "en",
  "strings": {
    "aLayoutThatNamesNoCountry": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Belegung ohne Land behält ihre Buchstaben, in einem Rahmen so groß wie eine Flagge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A layout that names no country keeps its letters, in a frame the same size as a flag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una distribución sin país conserva sus letras, en un marco del tamaño de una bandera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une disposition sans pays garde ses lettres, dans un cadre de la taille d’un drapeau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国が定まらない配列は文字のまま、旗と同じ大きさの枠に表示されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um layout sem país mantém as letras, numa moldura do tamanho de uma bandeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладка, не привязанная к стране, остается буквами — в рамке размером с флаг."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有国家归属的布局保持字母显示，边框与旗帜同样大小。"
          }
        }
      }
    },
