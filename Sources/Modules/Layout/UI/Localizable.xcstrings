    "nothingFixesTheSelectionOrThe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts korrigiert die Auswahl oder das letzte Wort, bis du eine Taste wählst oder unten eine Kombination aufnimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing fixes the selection or the last word until you pick a key, or record a combination below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada corrige la selección ni la última palabra hasta que elijas una tecla o registres una combinación abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne corrige la sélection ni le dernier mot tant que vous n’avez pas choisi une touche ou enregistré une combinaison ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを選ぶか、下で組み合わせを登録するまで、選択範囲も直前の単語も修正されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada corrige a seleção nem a última palavra até você escolher uma tecla ou registrar uma combinação abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока не выбрана клавиша и не задано сочетание ниже, исправить выделенное или последнее слово нечем."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在选择按键或在下方录制组合键之前，选中的文字和上一个词都不会被修正。"
          }
        }
      }
    },
