    "heldDownOrPressedTogetherWith": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehalten oder mit einer anderen Taste zusammen gedrückt bleibt sie ein gewöhnlicher Modifier — alles, wofür du sie schon nutzt, funktioniert weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held down, or pressed together with anything else, it stays an ordinary modifier — everything you already use it for keeps working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenida o pulsada junto con otra tecla, sigue siendo un modificador normal: todo lo que ya haces con ella sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenue ou combinée à une autre touche, elle reste un modificateur ordinaire\u00a0: tout ce que vous en faites déjà continue de fonctionner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したままにしたり、他のキーと一緒に押したりしたときは、これまでどおりの修飾キーとして働きます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantida pressionada, ou junto com outra tecla, continua sendo um modificador comum: tudo o que você já faz com ela segue funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зажатая или нажатая вместе с чем-то еще, она остается обычным модификатором — все, для чего ее уже используют, работает как прежде."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "按住不放，或与其他键一起按时，它仍是普通的修饰键——你原本的用法照旧。"
          }
        }
      }
    },
    "helloHelloButOnlyWhenThe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HAllo → Hallo, aber nur wenn dabei ein Wort herauskommt. IPhone und OSes bleiben, HALLO auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HEllo → Hello, but only when the result is a word. IPhone and OSes are left alone, and so is HELLO."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HOla → Hola, pero solo si el resultado es una palabra. IPhone y OSes se dejan como están, y HOLA también."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BOnjour → Bonjour, mais seulement si le résultat est un mot. IPhone et OSes restent tels quels, BONJOUR aussi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HEllo → Hello。ただし結果が単語になる場合だけです。IPhone や OSes、HELLO はそのままにします。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "OLá → Olá, mas só quando o resultado é uma palavra. IPhone e OSes ficam como estão, e OLÁ também."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПРивет → Привет, но только если получается слово. IPhone и OSes остаются как есть, и ПРИВЕТ тоже."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "HEllo → Hello，但仅当结果是一个单词时。IPhone、OSes 和 HELLO 都不改。"
          }
        }
      }
    },
