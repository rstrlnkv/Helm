    "chosenRefused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner lässt sich nicht verwenden – Helm sichert deshalb auf dem Schreibtisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That folder cannot be used, so Helm saves to the Desktop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede usar esa carpeta, así que Helm guarda en el Escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est inutilisable. Helm enregistre donc sur le bureau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは使えないため、Helm はデスクトップに保存します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pasta não pode ser usada, então o Helm salva na Mesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту папку использовать нельзя, поэтому Helm сохраняет на рабочий стол."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用该文件夹，因此 Helm 会保存到桌面。"
          }
        }
      }
    },
    "confirmClose": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc erneut drücken, um ohne Sichern zu schließen"
          }
        },
        "en": {
