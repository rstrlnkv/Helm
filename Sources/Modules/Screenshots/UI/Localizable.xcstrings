        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede usar la carpeta que indica macOS, así que Helm guarda en el Escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier indiqué par macOS est inutilisable. Helm enregistre donc sur le bureau."
