    "needsAccess": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm kann den Bildschirm nicht lesen, solange die Aufnahme von Bildschirm & Systemaudio nicht erlaubt ist – die Kurzbefehle unten nehmen also nichts auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm cannot read the screen until Screen & System Audio Recording is allowed, so the shortcuts below capture nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm no puede leer la pantalla hasta que se permita la grabación de pantalla y del audio del sistema, así que los atajos de abajo no capturan nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm ne peut pas lire l’écran tant que l’enregistrement de l’écran et des sons du système n’est pas autorisé. Les raccourcis ci-dessous ne capturent donc rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録とシステムオーディオ録音が許可されるまで、Helm は画面を読み取れません。そのため、下のショートカットでは何も撮影されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm não consegue ler a tela até que a gravação do áudio do sistema e da tela seja permitida, então os atalhos abaixo não capturam nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm не может прочитать экран, пока не разрешена запись экрана и системного звука, поэтому сочетания ниже ничего не снимают."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在允许录屏与系统录音之前，Helm 无法读取屏幕，因此下面的快捷键不会截取任何内容。"
          }
        }
      }
    },
    "noPermissionBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Helm unter Aufnahme von Bildschirm & Systemaudio und drücke den Kurzbefehl erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Helm under Screen & System Audio Recording, then press the shortcut again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a Helm en Grabación de pantalla y del audio del sistema y vuelve a pulsar el atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Helm dans Enregistrement de l’écran et des sons du système, puis appuyez de nouveau sur le raccourci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録とシステムオーディオ録音で Helm を許可してから、もう一度ショートカットを押してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o Helm em Gravação do Áudio do Sistema e da Tela e pressione o atalho novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Helm в разделе «Запись экрана и системного звука» и нажмите сочетание еще раз."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请在录屏与系统录音中允许 Helm，然后再次按下快捷键。"
          }
        }
      }
    },
