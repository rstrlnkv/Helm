    "replaceBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um sie zu verwenden, deaktiviere die zugehörigen Kontrollfelder unten in den Systemeinstellungen. Helm liest diese Einstellung nur und ändert sie nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use them, untick their boxes below in System Settings. Helm reads that setting and never changes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usarlos, desmarca sus casillas de abajo en Ajustes del Sistema. Helm solo lee ese ajuste y nunca lo cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les utiliser, décochez leurs cases ci-dessous dans les Réglages Système. Helm lit ce réglage et ne le modifie jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使うには、システム設定で下のそれぞれのチェックを外してください。Helm はその設定を読み取るだけで、変更はしません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usá-los, desmarque as caixas correspondentes abaixo nos Ajustes do Sistema. O Helm apenas lê essa configuração e nunca a altera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы их использовать, снимите их галочки ниже в Системных настройках. Helm только читает эту настройку и никогда ее не меняет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
