    "folderNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier legt macOS Bildschirmfotos ab. Helm liest das nur und ändert es nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where macOS keeps screenshots. Helm reads it and never changes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde macOS guarda las capturas. Helm solo lo lee y nunca lo cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’endroit où macOS enregistre les captures d’écran. Helm le lit et ne le modifie jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がスクリーンショットを保存する場所です。Helm は読み取るだけで、変更しません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o macOS guarda as capturas de tela. O Helm apenas lê e nunca altera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где macOS хранит снимки экрана. Helm только читает это и не меняет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 保存截屏的位置。Helm 只读取，绝不更改。"
          }
        }
      }
    },
    "folderRefused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner, den macOS nennt, lässt sich nicht verwenden – Helm sichert deshalb auf dem Schreibtisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder macOS names cannot be used, so Helm saves to the Desktop."
