        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta indicada pelo macOS não pode ser usada, então o Helm salva na Mesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку, которую указывает macOS, использовать нельзя, поэтому Helm сохраняет на рабочий стол."
          }
        },
        "zh": {
