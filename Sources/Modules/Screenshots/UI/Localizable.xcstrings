    },
    "conflict": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS belegt diese Kombination noch für einen eigenen Kurzbefehl. Deaktiviere ihn zuerst unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS still holds this combination for one of its own shortcuts. Untick it below first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sigue usando esta combinación para uno de sus atajos. Desmárcalo primero más abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS utilise encore cette combinaison pour l’un de ses raccourcis. Décochez-le d’abord ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この組み合わせは、まだ macOS 自身のショートカットに使われています。先に下でチェックを外してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS ainda usa esta combinação em um de seus atalhos. Desmarque-o primeiro, abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание все еще занято одним из системных сочетаний macOS. Сначала снимите его галочку ниже."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 仍将此组合用于它自己的某个快捷键。请先在下方取消勾选。"
          }
        }
      }
    },
