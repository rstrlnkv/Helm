    "panelBoxWarning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Helm-Panel belegt ⇧⌘5 nur, wenn dies deaktiviert ist. Wird es deaktiviert, entfällt auch das Tastaturkürzel für die Bildschirmaufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm's panel takes ⇧⌘5 only when this is unticked. Unticking it also removes the keyboard shortcut for screen recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel de Helm solo toma ⇧⌘5 si esta casilla está desmarcada. Al desmarcarla también se elimina el atajo de teclado de la grabación de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau de Helm ne prend ⇧⌘5 que si cette case est décochée. La décocher supprime aussi le raccourci clavier de l’enregistrement d’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェックを外した場合にのみ、Helm のパネルが ⇧⌘5 を使います。外すと、画面収録のキーボードショートカットも使えなくなります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel do Helm só usa ⇧⌘5 se esta caixa estiver desmarcada. Desmarcá-la também remove o atalho de teclado da gravação de tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель Helm занимает ⇧⌘5, только если эта галочка снята. Без нее пропадает и сочетание клавиш для записи экрана."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当取消勾选此项时，Helm 的面板才会使用 ⇧⌘5。取消勾选也会移除屏幕录制的键盘快捷键。"
          }
        }
      }
    },
