    "blurPersonalText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mails und Telefonnummern weichzeichnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blur Emails and Phone Numbers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenfocar correos y teléfonos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flouter les e-mails et les téléphones"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスと電話番号をぼかす"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfocar e-mails e telefones"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размыть почту и телефоны"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊邮件和电话号码"
          }
        }
      }
    },
    "blurPersonalTextHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet E-Mail-Adressen, Telefon- und Kartennummern und Links weich, die macOS im Bild liest. Gesichter, Handschrift und alles Übrige bleiben, wie sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blurs email addresses, phone numbers, card numbers and links that macOS reads in the picture. Faces, handwriting and everything else stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenfoca las direcciones de correo, los números de teléfono y de tarjeta y los enlaces que macOS lee en la imagen. Las caras, la letra manuscrita y todo lo demás se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Floute les adresses e-mail, les numéros de téléphone et de carte et les liens que macOS lit dans l’image. Les visages, l’écriture manuscrite et tout le reste restent tels quels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が画像から読み取ったメールアドレス、電話番号、カード番号、リンクをぼかします。顔、手書き文字、その他はそのままです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfoca endereços de e-mail, números de telefone e de cartão e links que o macOS lê na imagem. Rostos, escrita à mão e todo o resto ficam como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размывает адреса почты, номера телефонов и карт и ссылки, которые macOS прочла на снимке. Лица, почерк и все остальное остаются как есть."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊 macOS 在图像中读到的电子邮件地址、电话号码、卡号和链接。人脸、手写内容及其他一切保持原样。"
          }
        }
      }
    },
    "blurred": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weichgezeichnet: %@. Prüfe den Rest selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blurred: %@. Check the rest yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenfocado: %@. Revisa tú el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flouté : %@. Vérifiez le reste vous-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼかした箇所：%@。残りは自分で確認してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfocado: %@. Confira você mesmo o resto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размыто мест: %@. Остальное проверьте сами."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已模糊：%@ 处。其余请自行检查。"
          }
        }
      }
    },
