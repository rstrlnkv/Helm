            "state": "translated",
            "value": "Las categorías y sus apps se ordenan según las veces que se abren aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories et leurs apps sont classées selon le nombre d’ouvertures depuis Launchpad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリとその中のアプリは、ここから開いた回数の多い順に並びます。"
          }
        },
        "pt": {
