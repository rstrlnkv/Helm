    "gridAutomaticNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt so viele Symbole ein, wie auf den Bildschirm passen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fits as many icons as the screen holds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca tantos iconos como quepan en la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place autant d’icônes que l’écran peut en contenir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に収まるだけのアイコンを並べます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaixa tantos ícones quanto a tela comportar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещает столько значков, сколько помещается на экране."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "按屏幕能容纳的数量排列图标。"
          }
        }
      }
    },
