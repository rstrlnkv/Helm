    "resetNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner und Reihenfolge werden wieder alphabetisch. Ausgeblendete Apps bleiben ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders and order go back to alphabetical. Hidden apps stay hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas y el orden vuelven a ser alfabéticos. Las apps ocultas siguen ocultas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers et l’ordre redeviennent alphabétiques. Les apps masquées restent masquées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダと順序はアルファベット順に戻ります。非表示のアプリは非表示のままです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas e a ordem voltam a ser alfabéticas. Os apps ocultos continuam ocultos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки и порядок вернутся к алфавитному. Скрытые приложения останутся скрытыми."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹和顺序将恢复为字母顺序。已隐藏的应用仍保持隐藏。"
          }
        }
      }
    },
