        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещение: %1$@, место %2$@ из %3$@, страница %4$@ из %5$@"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@已移到第 %2$@ 个，共 %3$@ 个，第 %4$@ 页，共 %5$@ 页"
          }
        }
      }
    },
