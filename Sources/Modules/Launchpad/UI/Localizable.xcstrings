    "launchCountsNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien und ihre Apps werden danach geordnet, wie oft sie hier geöffnet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories, and the apps in them, are ordered by how often you open them here."
          }
        },
        "es": {
