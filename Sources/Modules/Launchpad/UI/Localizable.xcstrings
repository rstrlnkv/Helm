    "gridFitNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das Gitter größer als der Bildschirm, werden die Symbole verkleinert und Zeilen, die nicht passen, ausgelassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the grid is larger than the screen, icons shrink and rows that cannot fit are left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la cuadrícula es mayor que la pantalla, los iconos se reducen y se omiten las filas que no caben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la grille dépasse la taille de l’écran, les icônes rétrécissent et les lignes qui ne tiennent pas sont omises."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドが画面より大きいときは、アイコンが縮小され、収まらない行は表示されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a grade é maior que a tela, os ícones diminuem e as linhas que não cabem são omitidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сетка больше экрана, значки уменьшаются, а строки, которые не помещаются, не показываются."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "网格大于屏幕时，图标会缩小，放不下的行会被省略。"
          }
        }
      }
    },
