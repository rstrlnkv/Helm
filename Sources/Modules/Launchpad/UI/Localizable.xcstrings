    "pinchSystemStillOn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuziehen von macOS ist noch aktiv und öffnet ebenfalls Apps. Schalte es in den Systemeinstellungen unter Trackpad, Weitere Gesten aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS’s own pinch is still on and opens Apps too. Turn it off in System Settings, under Trackpad, More Gestures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gesto de juntar los dedos de macOS sigue activado y también abre Apps. Desactívalo en Ajustes del Sistema, en Trackpad, Más gestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pincement de macOS est toujours activé et ouvre aussi Apps. Désactivez-le dans les Réglages Système, sous Trackpad, Gestes supplémentaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS自身のピンチ操作もオンのままで、アプリも開きます。システム設定の“トラックパッド”の“その他のジェスチャ”でオフにしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O gesto de juntar os dedos do macOS continua ativado e também abre Apps. Desative em Ajustes do Sistema, em Trackpad, Mais Gestos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственный жест сведения пальцев в macOS все еще включен и тоже открывает приложения. Выключите его в разделе «Системные настройки», «Трекпад», «Другие жесты»."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 自带的捏合手势仍处于开启状态，也会打开 App。请在“系统设置”的“触控板”下“更多手势”中将其关闭。"
          }
        }
      }
    },
