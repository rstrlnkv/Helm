    "dockIconNamed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ins Dock ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, drag to the Dock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, arrastra al Dock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, à faire glisser dans le Dock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、Dockにドラッグ"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, arraste para o Dock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, перетащите в Dock"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，拖到程序坞"
          }
        }
      }
    },
    "dockIconNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe dieses Symbol ins Dock und klicke es dann an, um Launchpad zu öffnen. Wenn Helm verschoben wird, ziehe es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag this icon to the Dock, then click it to open Launchpad. If Helm moves, drag it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra este icono al Dock y haz clic en él para abrir Launchpad. Si Helm se mueve, vuelve a arrastrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser cette icône dans le Dock, puis cliquez dessus pour ouvrir Launchpad. Si Helm est déplacé, faites-la glisser à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアイコンをDockにドラッグし、クリックするとLaunchpadが開きます。Helmを移動したときは、もう一度ドラッグしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste este ícone para o Dock e clique nele para abrir o Launchpad. Se o Helm for movido, arraste-o de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите этот значок в Dock и нажмите на него, чтобы открыть Launchpad. Если Helm переместить, перетащите значок снова."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将此图标拖到程序坞，点按即可打开启动台。如果移动了 Helm，请重新拖动。"
          }
        }
      }
    },
