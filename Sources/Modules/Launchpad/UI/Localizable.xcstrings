    "announceMoved": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verschoben auf Platz %2$@ von %3$@, Seite %4$@ von %5$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ moved to place %2$@ of %3$@, page %4$@ of %5$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se movió al lugar %2$@ de %3$@, página %4$@ de %5$@"
