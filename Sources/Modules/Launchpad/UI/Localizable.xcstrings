    "gridAutomaticNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jedem Bildschirm sieben Spalten und fünf Zeilen. Symbole und Namen wachsen mit dem Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven columns and five rows on every screen. Icons and names grow with the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete columnas y cinco filas en cada pantalla. Los iconos y los nombres crecen con la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sept colonnes et cinq lignes sur chaque écran. Les icônes et les noms grandissent avec l’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの画面でも7列5行です。アイコンと名前は画面に合わせて大きくなります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sete colunas e cinco linhas em cada tela. Os ícones e os nomes crescem com a tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семь столбцов и пять строк на любом экране. Значки и названия растут вместе с экраном."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每块屏幕都是7列5行。图标和名称会随屏幕放大。"
          }
        }
      }
    },
