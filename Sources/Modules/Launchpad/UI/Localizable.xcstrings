    "pinchNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier oder fünf Finger, auf dem Trackpad zugezogen, öffnen Launchpad; Aufziehen schließt es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four or five fingers brought together on the trackpad open Launchpad; spreading them closes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro o cinco dedos juntados en el trackpad abren Launchpad; separarlos lo cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre ou cinq doigts rapprochés sur le trackpad ouvrent Launchpad ; les écarter le ferme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッドで4本または5本の指をつまむように閉じるとLaunchpadが開き、広げると閉じます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro ou cinco dedos juntos no trackpad abrem o Launchpad; afastá-los o fecha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если свести четыре или пять пальцев на трекпаде, Launchpad откроется; если развести, закроется."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在触控板上用四指或五指捏合会打开启动台，张开则关闭。"
          }
        }
      }
    },
