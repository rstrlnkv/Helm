        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt Automatisch, Gesamtgröße, Zeilen, Spalten, die Symbolgröße und die App-Namen zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resets Automatic, Overall size, rows, columns, icon size and app names."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece Automático, tamaño general, filas, columnas, el tamaño de los iconos y los nombres de las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
