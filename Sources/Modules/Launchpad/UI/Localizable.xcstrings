    "resetNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner und Reihenfolge werden wieder alphabetisch. Ausgeblendete Apps bleiben ausgeblendet. Verschobene Apps bleiben in der gewählten Kategorie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders and order go back to alphabetical. Hidden apps stay hidden. Moved apps stay in their chosen categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas y el orden vuelven a ser alfabéticos. Las apps ocultas siguen ocultas. Las apps trasladadas siguen en la categoría elegida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers et l’ordre redeviennent alphabétiques. Les apps masquées restent masquées. Les apps déplacées restent dans la catégorie choisie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダと順序はアルファベット順に戻ります。非表示のアプリは非表示のままです。移動したアプリは選んだカテゴリに残ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas e a ordem voltam a ser alfabéticas. Os apps ocultos continuam ocultos. Os apps movidos continuam na categoria escolhida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки и порядок вернутся к алфавитному. Скрытые приложения останутся скрытыми. Перемещенные приложения останутся в выбранной категории."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹和顺序将恢复为字母顺序。已隐藏的应用仍保持隐藏。已移动的应用仍保留在所选类别中。"
          }
        }
      }
    },
