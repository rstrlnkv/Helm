    "failureSecretUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm konnte die gespeicherten Einstellungen von %@ nicht lesen und hat deshalb keine Verbindung aufgebaut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
