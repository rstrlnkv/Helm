          "stringUnit": {
            "state": "translated",
            "value": "Helm 无法读取%@已保存的设置，因此未连接"
          }
        }
      }
    },
    "failureRefusedConnect": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat %@ nicht verbunden — was es sagte, steht im Protokoll"
          }
        },
