    "withThisOffAndThe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist dies aus und der Hinweis auf „Nichts“ gestellt, verbindet oder trennt eine Regel ohne jedes Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this off and the notice set to Nothing, a rule that connects or drops a tunnel gives no sign at all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esto desactivado y el aviso en “Nada”, una regla que conecta o corta un túnel no da ninguna señal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ceci désactivé et l’avis réglé sur «\u00a0Rien\u00a0», une règle qui connecte ou coupe un tunnel ne donne aucun signe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをオフにし、通知も“なし”にすると、ルールが接続・切断しても何も知らせません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com isto desligado e o aviso em “Nada”, uma regra que conecta ou derruba um túnel não dá sinal algum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это выключено, а уведомление — «Ничего», правило подключит или отключит туннель незаметно."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此项且提示设为“无”时，规则连接或断开隧道将没有任何提示。"
          }
        }
      }
    }
  },
  "version": "1.0"
