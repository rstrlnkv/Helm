    "helmConnectsTheConfigurationsMacOS": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm verbindet die Konfigurationen, die macOS verwaltet — von Hand oder nach einer Regel, wenn eine App startet. Neue legst du in den Systemeinstellungen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm connects the configurations macOS holds — by hand, or by rule when an app opens. Add one in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm conecta las configuraciones que guarda macOS, a mano o por reglas cuando se abre una app. Añade una en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm connecte les configurations que macOS conserve — à la main, ou selon une règle à l’ouverture d’une app. Ajoutez-en une dans les Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm は macOS が保持する構成を、手動でも、アプリの起動に合わせたルールでも接続できます。構成そのものはシステム設定で追加します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm conecta as configurações que o macOS mantém — à mão ou por regra, quando um app abre. Adicione uma nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm подключает конфигурации, которые хранит macOS, — вручную или по правилам, когда открывается приложение. Новая конфигурация добавляется в Системных настройках."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm 可以手动连接 macOS 保存的配置，也可以在应用启动时按规则连接。配置本身在“系统设置”中添加。"
          }
        }
      }
    },
    "helmPicksItUpOn": {
