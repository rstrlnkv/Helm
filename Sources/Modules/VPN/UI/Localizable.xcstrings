    "secretNeedsAPress": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke einmal „%1$@“ für %2$@ — eine Regel kann den gespeicherten Schlüssel nicht abrufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %1$@ once for %2$@ — a rule cannot unlock its stored secret"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa “%1$@” una vez en %2$@: una regla no puede acceder a su clave guardada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez une fois sur «\u00a0%1$@\u00a0» pour %2$@\u00a0: une règle ne peut pas accéder à sa clé enregistrée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@で一度“%1$@”を押してください。ルールでは保存された鍵を読み出せません"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em “%1$@” uma vez para %2$@ — uma regra não consegue acessar a chave salva"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %2$@ нужно один раз нажать «%1$@» — правилу сохраненный ключ недоступен"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请为%2$@按一次“%1$@”——规则无法取用已保存的密钥"
          }
        }
      }
    },
