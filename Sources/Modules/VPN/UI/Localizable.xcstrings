{
  "sourceLanguage": "en",
  "strings": {
    "aVPNCarriesEverythingThis": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über ein VPN läuft der gesamte Verkehr dieses Mac, nicht nur der dieser App — und der Tunnel steht erst einige Sekunden nach dem Start."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A VPN carries everything this Mac sends, not only the app it names, and it takes a few seconds to come up after the app starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una VPN lleva todo el tráfico de este Mac, no solo el de esa app, y el túnel tarda unos segundos en establecerse tras abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un VPN transporte tout le trafic de ce Mac, pas seulement celui de cette app, et le tunnel met quelques secondes à s’établir après l’ouverture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN はこの Mac の通信すべてを運びます。そのアプリの分だけではありません。トンネルは起動から数秒後につながります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma VPN leva todo o tráfego deste Mac, não só o desse app, e o túnel leva alguns segundos para subir depois que ele abre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через VPN идет весь трафик этого Mac, а не только трафик приложения. Туннель поднимается через несколько секунд после запуска приложения."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 承载这台 Mac 的全部流量，不只是该应用的，而且隧道要在应用启动几秒后才建立。"
          }
        }
      }
    },
    "addAnotherInSystemSettings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine weitere legst du in den Systemeinstellungen an — Helm übernimmt sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add another in System Settings and Helm picks it up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade otra en Ajustes del Sistema y Helm la detecta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-en une autre dans les Réglages Système et Helm la reprend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で追加すれば、Helm が引き継ぎます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione outra nos Ajustes do Sistema e o Helm a detecta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая конфигурация добавляется в Системных настройках — Helm подхватит ее сам."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置”中添加后，Helm 会自动识别。"
          }
        }
      }
    },
