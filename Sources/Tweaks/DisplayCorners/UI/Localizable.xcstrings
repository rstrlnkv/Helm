    "calibrationNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt die oberen Ecken des integrierten Bildschirms, um den Radius zu beurteilen. Endet beim Verlassen dieser Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colours the top corners of the built-in display to judge the radius. Ends when you leave this page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorea las esquinas superiores de la pantalla integrada para juzgar el radio. Termina al salir de esta página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore les coins supérieurs de l’écran intégré pour juger du rayon. Prend fin quand vous quittez cette page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵ディスプレイの上の角に色を付けて、半径を確認できます。このページを離れると終了します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore os cantos superiores da tela integrada para avaliar o raio. Termina quando você sai desta página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрашивает верхние углы встроенного дисплея, чтобы оценить радиус. Завершается при уходе с этой страницы."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "为内建显示器的上方两个角着色，以便判断圆角半径。离开此页面时结束。"
          }
        }
      }
    },
