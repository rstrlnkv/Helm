    "displayCornersSummary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rundet die unteren Ecken des integrierten Bildschirms ab, auf Wunsch auch die externer Bildschirme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rounds the bottom corners of the built-in display, and external displays if you choose"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redondea las esquinas inferiores de la pantalla integrada y, si lo eliges, las de las pantallas externas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrondit les coins inférieurs de l’écran intégré, et ceux des écrans externes si vous le choisissez"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵ディスプレイの下の角を丸くし、選べば外部ディスプレイも丸くする"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arredonda os cantos inferiores da tela integrada e, se você quiser, das telas externas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скругляет нижние углы встроенного дисплея и, по желанию, внешних дисплеев"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "为内置显示器下方的两个角添加圆角，也可按需用于外接显示器"
          }
        }
      }
    }
  },
  "version": "1.0"
