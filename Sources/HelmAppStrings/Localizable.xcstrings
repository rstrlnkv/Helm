    "backgroundScansNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Module durchsuchen deine Dateien von selbst – nur wenn der Mac inaktiv, entsperrt und am Strom ist, und höchstens zweimal täglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These modules look through your files on their own — only when the Mac is idle, unlocked and on power, and no more than twice a day each."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos módulos revisan tus archivos por su cuenta: solo cuando el Mac está inactivo, desbloqueado y conectado a la corriente, y como máximo dos veces al día cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces modules parcourent vos fichiers d’eux-mêmes, uniquement quand le Mac est inactif, déverrouillé et branché, et au maximum deux fois par jour chacun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのモジュールは自動的にファイルを調べます。Mac が操作されておらず、ロックが解除され、電源に接続されているときだけ、それぞれ 1 日 2 回までです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes módulos percorrem seus arquivos por conta própria — apenas quando o Mac está ocioso, desbloqueado e na tomada, e no máximo duas vezes por dia cada um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти модули сами просматривают ваши файлы — только когда Mac простаивает, разблокирован и подключен к питанию, и не чаще двух раз в день каждый."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这些模块会自行浏览你的文件——仅在 Mac 闲置、已解锁并接通电源时，每个每天最多两次。"
          }
        }
      }
    },
