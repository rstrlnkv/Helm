    "logRedactionNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Protokoll hält fest, was Helm getan hat, nicht was du hast: App-Namen, VPN-Namen und Pfade werden ersetzt, bevor etwas geschrieben wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The log records what Helm did, not what you have: app names, VPN names and paths are replaced before anything is written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro anota lo que hizo Helm, no lo que tienes: los nombres de apps, los nombres de VPN y las rutas se sustituyen antes de escribir nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal note ce que Helm a fait, pas ce que vous avez : les noms d’apps, les noms de VPN et les chemins sont remplacés avant toute écriture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログに残るのは Helm が何をしたかであり、あなたが何を持っているかではありません。App 名、VPN 名、パスは書き込む前に置き換えられます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro anota o que o Helm fez, não o que você tem: nomes de apps, nomes de VPN e caminhos são substituídos antes de qualquer gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В журнал попадает то, что делает Helm, а не то, что у вас на диске: имена приложений, названия VPN и пути подменяются еще до записи."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "日志记录的是 Helm 做了什么，而不是你有什么：应用名称、VPN 名称和路径在写入前都会被替换。"
          }
        }
      }
    },
