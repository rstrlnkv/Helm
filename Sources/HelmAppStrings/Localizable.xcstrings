        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのビルドはチャンネルより新しいバージョンです（チャンネルの最新は %@）。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua build é mais recente que o canal — a última dele é %@."
          }
        },
        "ru": {
