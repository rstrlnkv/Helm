    "loginItemRefused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat Helm nicht zu den Anmeldeobjekten hinzugefügt, es öffnet sich also nicht von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS would not add Helm to your login items, so it will not open by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no ha añadido Helm a los ítems de inicio, así que no se abrirá por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas ajouté Helm à l’ouverture de session, il ne s’ouvrira donc pas tout seul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が Helm をログイン項目に追加しませんでした。Helm は自動的には開きません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não adicionou o Helm aos itens de início de sessão, portanto ele não abrirá sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm не удалось добавить в объекты входа, поэтому сам он открываться не будет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未将 Helm 加入登录项，因此它不会自动打开。"
          }
        }
      }
