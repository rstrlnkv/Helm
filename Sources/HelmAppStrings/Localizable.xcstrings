    "screenRecording": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme von Bildschirm & Systemaudio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen & System Audio Recording"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación de pantalla y del audio del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement de l’écran et des sons du système"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録とシステムオーディオ録音"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação do Áudio do Sistema e da Tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись экрана и системного звука"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "录屏与系统录音"
          }
        }
      }
    },
    "screenRecordingReason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme von Bildschirm & Systemaudio ist ausgeschaltet. Ohne sie kann Helm den Bildschirm nicht lesen, daher nehmen die Kurzbefehle für Bildschirmfotos nichts auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen & System Audio Recording is off. Without it Helm cannot read the screen, so the screenshot shortcuts capture nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación de pantalla y del audio del sistema está desactivada. Sin ella Helm no puede leer la pantalla y los atajos de captura no capturan nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement de l’écran et des sons du système est désactivé. Sans lui, Helm ne peut pas lire l’écran et les raccourcis de capture ne capturent rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録とシステムオーディオ録音がオフです。このままでは Helm は画面を読み取れず、スクリーンショットのショートカットは何も撮影しません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação do áudio do sistema e da tela está desativada. Sem ela o Helm não consegue ler a tela, e os atalhos de captura não capturam nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись экрана и системного звука выключена. Без нее Helm не может прочитать экран, поэтому сочетания для снимков ничего не снимают."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "录屏与系统录音已关闭。没有它，Helm 无法读取屏幕，截屏快捷键不会截取任何内容。"
          }
        }
      }
    },
    "screenRecordingWhy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig, damit Bildschirmfotos den Bildschirm aufnehmen können. Helm nimmt weder Video noch Ton auf — macOS hat nur einen Schalter für das Lesen von Pixeln und für Aufnahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed for Screenshots to capture the screen. Helm records no video and no sound — macOS simply has one switch for reading pixels and for recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para que Capturas de pantalla pueda capturar la pantalla. Helm no graba vídeo ni sonido: macOS solo tiene un interruptor para leer píxeles y para grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour que Captures d’écran puisse capturer l’écran. Helm n’enregistre ni vidéo ni son — macOS n’a simplement qu’un seul réglage pour lire les pixels et pour enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットが画面を撮影するために必要です。Helm は映像も音も録画・録音しません。macOS では、ピクセルの読み取りと録画が同じスイッチにまとめられているだけです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para o Capturas de Tela capturar a tela. O Helm não grava vídeo nem som — o macOS só tem um controle para ler pixels e para gravar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы Снимки экрана могли снимать экран. Helm не записывает ни видео, ни звук — просто у macOS один переключатель и на чтение пикселей, и на запись."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "截屏功能需要此权限才能截取屏幕。Helm 不录制视频，也不录音——只是 macOS 把读取像素和录制用同一个开关管理。"
          }
        }
      }
    },
