    "fullDiskAccessAdHoc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff gilt für genau eine Kopie von Helm: nach jedem Update neu erteilen — Helm mit „−“ entfernen, mit „+“ hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is tied to one exact copy of Helm, so grant it again after every update: remove Helm with “−”, then add it with “+”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso se vincula a una copia exacta de Helm: concédelo de nuevo tras cada actualización — quita Helm con “−” y añádelo con “+”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès est lié à une copie précise de Helm : accordez-le de nouveau après chaque mise à jour — retirez Helm avec « − », puis ajoutez-le avec « + »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス権は Helm の特定のコピーに紐づきます。更新のたびに再設定してください：“−”で削除し“+”で追加。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso é vinculado a uma cópia exata do Helm: conceda de novo após cada atualização — remova com “−” e adicione com “+”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ привязан к конкретной копии Helm, поэтому после каждого обновления выдайте его заново: удалите Helm кнопкой «−» и добавьте кнопкой «+»."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "权限绑定到 Helm 的具体副本，每次更新后需重新授予：用“−”移除，再用“+”添加。"
          }
        }
      }
    },
    "fullDiskAccessReason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Festplattenzugriff ist aus. Ohne ihn sieht die Analyse nicht alle Ordner, und beim Entfernen bleiben Container liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full disk access is off. Without it the disk scan cannot read every folder, and removing an app leaves its containers behind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al disco está desactivado. Sin él el escaneo no ve todas las carpetas y al desinstalar quedan los contenedores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au disque est désactivé. Sans lui l’analyse ne voit pas tous les dossiers, et la désinstallation laisse les conteneurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクへのアクセスがオフです。すべてのフォルダを読めず、アンインストーラ時にコンテナが残ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao disco está desligado. Sem ele a varredura não lê todas as pastas e a remoção deixa contêineres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Доступ к диску» выключен. Без него скан диска не видит часть папок, а при удалении приложения его контейнеры остаются."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘访问已关闭。扫描无法读取全部文件夹，卸载应用时容器会残留。"
          }
        }
      }
    },
    "fullDiskAccessWhy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig, um App-Container zu entfernen und beim Scannen alle Ordner zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to remove app containers and to read every folder when scanning the disk."
          }
        },
        "es": {
