    "accessibility": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessibilidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无障碍"
          }
        }
      }
    },
    "accessibilityReason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bedienungshilfen sind aus. Ohne sie sieht Helm nicht, was du tippst — Tastaturkorrektur und Zeigerbewegung bleiben wirkungslos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is off. Without it Helm cannot see what you type, so keyboard corrections and the pointer nudge do nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La accesibilidad está desactivada. Sin ella Helm no ve lo que escribes: ni corrección de teclado ni movimiento del puntero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accessibilité est désactivée. Sans elle Helm ne voit pas ce que vous tapez : ni correction clavier ni mouvement du pointeur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティがオフです。入力内容を読み取れず、キーボード修正もポインタ移動も動作しません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A acessibilidade está desligada. O Helm não vê o que você digita: correção de teclado e movimento do ponteiro não funcionam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ выключен. Без него Helm не видит набранное — исправление раскладки и движение указателя не работают."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无障碍已关闭。Helm 无法读取输入，键盘修正与指针移动都不起作用。"
          }
        }
      }
    },
    "accessibilityWhy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig, damit Tastatur die Belegung des Getippten korrigiert und Wach halten den Zeiger bewegt. Ohne die Freigabe funktioniert beides nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed for Keyboard to fix the layout of what you type, and for Keep Awake to nudge the pointer. Without it neither works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para que Teclado corrija la distribución de lo que escribes y para que Mantener activo mueva el puntero. Sin él no funciona ninguno de los dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour que Clavier corrige la disposition de ce que vous tapez et que Rester éveillé bouge le pointeur. Sans lui, aucun des deux ne fonctionne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“キーボード”が入力したテキストの配列を直し、“スリープ防止”がポインタを動かすために必要です。許可がないとどちらも機能しません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para o Teclado corrigir o layout do que você digita e para o Manter ativo mover o ponteiro. Sem ele, nenhum dos dois funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен, чтобы «Клавиатура» исправляла раскладку набранного, а «Не спать» двигал указатель. Без него не работает ни то, ни другое."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "“键盘”纠正你输入内容的布局、“保持唤醒”移动指针都需要此权限。未授予时两者都不起作用。"
          }
        }
      }
    },
