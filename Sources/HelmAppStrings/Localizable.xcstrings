    "sidebarComposerNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Umsortieren ziehen. Ein Modul kann in jeden Bereich, und ein entfernter Bereich übergibt seine Module dem Nachbarn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. A module can go into any section, and a section you remove hands its modules to its neighbour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Un módulo puede ir a cualquier sección, y una sección eliminada entrega sus módulos a la vecina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner. Un module peut aller dans n’importe quelle section, et une section supprimée confie ses modules à sa voisine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。モジュールはどのセクションにも入れられ、削除したセクションのモジュールは隣に移ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Um módulo pode ir para qualquer secção, e uma secção removida entrega os seus módulos à vizinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте, чтобы менять порядок. Модуль можно положить в любой раздел, а удаленный раздел отдает свои модули соседнему."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可重新排序。模块可放入任意分组；删除分组后，其中的模块会移交给相邻分组。"
          }
        }
      }
    },
