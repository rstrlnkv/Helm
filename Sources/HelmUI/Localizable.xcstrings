    "readOnlyVolume": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Volume ist schreibgeschützt. Wirf es aus und entsperre es, oder kopiere das Nötige woandershin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk this is on is read-only. Eject it and unlock it, or copy what you need elsewhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco es de solo lectura. Expúlsalo y desbloquéalo, o copia lo que necesites en otro sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est en lecture seule. Éjectez-le et déverrouillez-le, ou copiez ailleurs ce dont vous avez besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスクは読み出し専用です。取り出してロックを解除するか、必要なものを別の場所にコピーしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco é somente leitura. Ejete-o e desbloqueie-o, ou copie o que precisa para outro lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
