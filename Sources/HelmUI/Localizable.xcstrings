    "noPermission": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist gesperrt oder gehört dir nicht. Öffne „Informationen“ im Finder, um sie zu entsperren oder die Rechte zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is locked, or you are not its owner. Open Get Info in the Finder to unlock it or change its permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo está bloqueado o no te pertenece. Abre “Obtener información” en el Finder para desbloquearlo o cambiar sus permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est verrouillé ou ne vous appartient pas. Ouvrez « Lire les informations » dans le Finder pour le déverrouiller ou changer ses autorisations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルがロックされているか、あなたの所有物ではありません。Finder の“情報を見る”でロックを解除するか、アクセス権を変更してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo está bloqueado ou não pertence a você. Abra “Obter Informações” no Finder para desbloqueá-lo ou mudar as permissões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл защищён или принадлежит другому пользователю. Откройте «Свойства» в Finder: снимите защиту или измените права доступа."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已锁定，或不属于你。在访达中打开“显示简介”解锁，或修改其权限。"
          }
        }
      }
    },
