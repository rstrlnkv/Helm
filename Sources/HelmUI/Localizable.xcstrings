    "introBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm besteht aus Modulen. Jedes erledigt eine Sache, und was du nicht brauchst, schaltest du ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm is made of modules. Each one does a single job, and you can switch off the ones you do not want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm está hecho de módulos. Cada uno hace una sola cosa, y puedes desactivar los que no quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm se compose de modules. Chacun fait une seule chose, et vous pouvez désactiver ceux dont vous ne voulez pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm はモジュールでできています。それぞれが一つの仕事をし、要らないものはオフにできます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm é feito de módulos. Cada um faz uma única coisa, e você pode desligar os que não quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm состоит из модулей. Каждый делает одно дело, и ненужные можно выключить."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm 由若干模块组成。每个模块只做一件事，不需要的可以关掉。"
          }
        }
      }
    },
