    "unknownReason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat das nicht verschoben. Zeig es im Finder und versuch es dort — der Finder sagt mehr dazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS would not move this. Show it in the Finder and try from there — the Finder says more about why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no movió esto. Muéstralo en el Finder e inténtalo desde ahí: el Finder explica mejor el motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas déplacé cet élément. Affichez-le dans le Finder et réessayez depuis là : le Finder en dit plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がこれを移動しませんでした。Finder で表示してそちらから試してください。理由は Finder のほうが詳しく教えてくれます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não moveu isto. Mostre no Finder e tente por lá — o Finder explica melhor o motivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не дала переместить файл. Покажите его в Finder и попробуйте оттуда — Finder объясняет причину подробнее."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未能移动它。请在访达中显示并从那里尝试——访达会给出更详细的原因。"
          }
        }
      }
    },
