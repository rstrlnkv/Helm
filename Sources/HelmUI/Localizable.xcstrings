    "diskFull": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Volume ist voll. In den Papierkorb legen braucht Platz, denn der Papierkorb liegt auf demselben Volume — leere ihn und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk is full. Moving to the Trash needs room, because the Trash is a folder on the same disk — empty it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco está lleno. Trasladar a la papelera necesita espacio, porque la papelera es una carpeta del mismo disco: vacíala e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est plein. Placer dans la corbeille demande de la place, car la corbeille est un dossier du même disque — videz-la et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの空きがありません。ゴミ箱は同じディスク上のフォルダなので、移動にも空き容量が要ります。ゴミ箱を空にしてからもう一度お試しください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco está cheio. Mover para o Lixo precisa de espaço, porque o Lixo é uma pasta do mesmo disco — esvazie-o e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На диске нет места. Корзина — папка на том же диске, поэтому для перемещения тоже нужно место. Очистите Корзину и попробуйте снова."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘已满。废纸篓就在同一块磁盘上，所以移入也需要空间——请先清倒废纸篓再试。"
          }
        }
      }
    },
