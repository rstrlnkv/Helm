{
  "sourceLanguage": "en",
  "strings": {
    "activeSystemExtension": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemerweiterung der App ist noch aktiv — in „Anmeldeobjekte & Erweiterungen“ deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its system extension is still active — turn it off in Login Items & Extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extensión del sistema de la app sigue activa: desactívala en “Ítems de inicio y extensiones”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’extension système de l’app est encore active — désactivez-la dans « Ouverture et extensions »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App のシステム機能拡張がまだ有効です。“ログイン項目と機能拡張”でオフにしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A extensão do sistema do app ainda está ativa — desative-a em “Itens de Início de Sessão e Extensões”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системное расширение приложения ещё работает — выключите его в «Объектах входа и расширениях»."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "该应用的系统扩展仍在运行 — 请在“登录项与扩展”中关闭。"
          }
        }
      }
    },
