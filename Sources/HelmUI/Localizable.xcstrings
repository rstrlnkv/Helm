    "changedSinceScan": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist nicht mehr dort, wo Helm es gefunden hat — es wurde nichts verschoben. Scanne erneut, um zu sehen, wo es jetzt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not where Helm found it, so nothing was moved. Scan again to see where it is now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ya no está donde Helm lo encontró, así que no se movió nada. Escanea de nuevo para ver dónde está ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est plus là où Helm l’a trouvé — rien n’a été déplacé. Réanalysez pour voir où il est maintenant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm が見つけた場所にもう存在しないため、何も移動していません。再スキャンして現在の場所を確認してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto já não está onde o Helm encontrou, então nada foi movido. Escaneie de novo para ver onde está agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл уже не там, где его нашли, — Helm его не тронул. Сканируйте заново, чтобы увидеть, где он теперь."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "它已不在 Helm 找到它的位置，因此没有移动任何内容。请重新扫描以查看它现在的位置。"
          }
        }
      }
    },
    "changedSinceSearch": {
      "extractionState": "manual",
