    "missingAfterScan": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist nicht mehr da, es wurde also nichts verschoben. Scanne erneut, um zu sehen, was übrig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not there any more, so nothing was moved. Scan again to see what is left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ya no existe, así que no se movió nada. Escanea de nuevo para ver qué queda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément n’existe plus, rien n’a été déplacé. Réanalysez pour voir ce qui reste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはもう存在しないため、何も移動していません。再スキャンして残りを確認してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto já não existe, então nada foi movido. Escaneie de novo para ver o que restou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекта уже нет — Helm ничего не переместил. Сканируйте заново, чтобы увидеть, что осталось."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "它已不存在，因此没有移动任何内容。请重新扫描以查看还剩下什么。"
          }
        }
      }
    },
