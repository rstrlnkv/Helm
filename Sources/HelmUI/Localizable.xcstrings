    "unreadable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm konnte es oder die verbleibende Kopie nicht lesen, es wurde also nichts verschoben. Prüfe, ob sich beide öffnen lassen, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm could not read it, or the copy that stays, so nothing was moved. Check that both can be opened and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm no pudo leerlo, o la copia que se conserva, así que no se movió nada. Comprueba que ambos se pueden abrir y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm n’a pas pu lire ce fichier, ou la copie conservée — rien n’a été déplacé. Vérifiez que les deux peuvent être ouverts et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm はこのファイル、または残るコピーを読み取れなかったため、何も移動していません。両方を開けることを確認して、もう一度お試しください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Helm não conseguiu lê-lo, ou a cópia que fica, então nada foi movido. Verifique se ambos podem ser abertos e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm не смог прочитать файл или ту копию, что остаётся, — ничего не перемещено. Проверьте, что оба открываются, и повторите попытку."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm 无法读取它或保留的那份副本，因此没有移动任何内容。请确认两者都能打开，然后重试。"
          }
        }
      }
    },
